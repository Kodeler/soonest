DATABASE_URL="file:./dev.db"

# Turso (for Vercel deployment — free at turso.tech)
# TURSO_DATABASE_URL=libsql://your-db-name-your-org.turso.io
# TURSO_AUTH_TOKEN=your_turso_token

# Square sandbox (optional — app runs mock-only without these)
# SQUARE_ACCESS_TOKEN=your_square_sandbox_token
# SQUARE_APPLICATION_ID=your_square_app_id
# SQUARE_APPLICATION_SECRET=your_square_app_secret
# SQUARE_ENVIRONMENT=sandbox

# Zocdoc sandbox (optional — US health only)
# ZOCDOC_CLIENT_ID=your_zocdoc_client_id
# ZOCDOC_CLIENT_SECRET=your_zocdoc_client_secret
# ZOCDOC_ENV=sandbox

# Mapbox (optional — degrades to list-only without)
# NEXT_PUBLIC_MAPBOX_TOKEN=your_mapbox_token

# Seed city (change to any city)
SEED_CITY=Toronto
SEED_LAT=43.6532
SEED_LNG=-79.3832
